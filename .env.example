# Copy this file to .env.local and fill in your own values
DATABASE_URL=postgresql://grievance_app:your_password@localhost:5432/grievance_db
# any long random string, used to sign the login cookie
JWT_SECRET=change_me_to_a_long_random_string
# secret code needed to register as staff, head or admin on the Register page
# (leave empty to turn that off, citizens can always register)
STAFF_SIGNUP_CODE=
